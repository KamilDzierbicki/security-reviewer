# Copy to .env and replace every value for anything beyond local use.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
FINGERPRINT_KEY=change-me-to-at-least-32-random-characters
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-to-at-least-16-characters
# Optional: enables the LLM summary (otherwise a deterministic template is used).
ANTHROPIC_API_KEY=
# Optional: raises the GitHub API rate limit for "Add repository".
GITHUB_TOKEN=
WEB_PORT=8080
# "production" makes the app refuse to start while a secret above still has
# its local-only default from docker-compose.yml.
NODE_ENV=development
